# Generate new Ozon keys; never paste real values into Git or chat.
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_PERFORMANCE_CLIENT_ID=
OZON_PERFORMANCE_CLIENT_SECRET=

# One bearer token protects both GPT Action and the read-only /mcp endpoint.
GPT_ACTION_TOKEN=change-me-to-a-long-random-value
# Comma-separated exact Host values accepted by the MCP transport.
MCP_ALLOWED_HOSTS=ozon-ai-analytics-production.up.railway.app,ozon-ai-analytics-production.up.railway.app:*,localhost:*,127.0.0.1:*
DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD=change-me-to-a-different-long-random-value
# Railway: set DATABASE_URL to ${{Postgres.DATABASE_URL}} in service variables.
DATABASE_URL=
SYNC_ENABLED=false
TIMEZONE=Europe/Moscow

# Management-report defaults. Override in Railway only if your accountant
# confirms different rates. Per-SKU VAT from the costs CSV takes priority.
DEFAULT_SALE_VAT_RATE=22
DEFAULT_PURCHASE_VAT_RATE=22
OZON_SERVICE_VAT_RATE=22
INCOME_TAX_RATE=25
