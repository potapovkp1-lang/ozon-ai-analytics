# Generate new Ozon keys; never paste real values into Git or chat.
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_PERFORMANCE_CLIENT_ID=
OZON_PERFORMANCE_CLIENT_SECRET=

# Separate secret for ChatGPT GPT Action requests.
GPT_ACTION_TOKEN=change-me-to-a-long-random-value
# Railway: set DATABASE_URL to ${{Postgres.DATABASE_URL}} in service variables.
DATABASE_URL=
SYNC_ENABLED=false
TIMEZONE=Europe/Moscow
